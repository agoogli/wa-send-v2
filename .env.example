# Database Configuration
POSTGRES_USER=wa-send-v2
POSTGRES_PASSWORD=wa-send-v2
POSTGRES_DB=wa-send-v2
DATABASE_URL=postgresql://wa-send-v2:wa-send-v2@db:5432/wa-send-v2?schema=public

# Security Settings
JWT_SECRET=your-super-secret-key-change-this-in-production

# SendApp API Configuration
# Key rilasciata dalla piattaforma SendApp
SENDAPP_API_KEY=your-sendapp-api-token-here
# URL base API SendApp (es. https://official.sendapp.cloud/api oppure https://app.sendapp.ai/api)
SENDAPP_API_URL=https://official.sendapp.cloud/api
# (Opzionale) Endpoint invio template (default: /send/template)
SENDAPP_API_ENDPOINT=/send/template
# (Opzionale) Nome del template Meta/SendApp configurato per l'invio messaggi (default: template_name)
SENDAPP_TEMPLATE_NAME=template_name
# (Opzionale) Codice lingua del template Meta (default: it)
SENDAPP_LANGUAGE_CODE=it
# (Opzionale) Delay tra l'invio di un messaggio e l'altro in millisecondi (default: 100)
SEND_DELAY_MS=100