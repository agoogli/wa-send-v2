# Database Configuration
POSTGRES_USER=wa-send-v2
POSTGRES_PASSWORD=wa-send-v2
POSTGRES_DB=wa-send-v2
DATABASE_URL=postgresql://wa-send-v2:wa-send-v2@db:5432/wa-send-v2?schema=public

# Security Settings
JWT_SECRET=your-super-secret-key-change-this-in-production

# SendApp API Configuration
# Key rilasciata dalla piattaforma SendApp (es. apikey / SENDAPP_API_KEY)
SENDAPP_API_KEY=
# Token del proprio account SendApp (es. token / ACCOUNT_TOKEN)
SENDAPP_ACCOUNT_TOKEN=
# URL base API SendApp (es. https://app.sendapp.ai/api oppure https://official.sendapp.cloud/api)
SENDAPP_API_URL=https://app.sendapp.ai/api
# Endpoint invio template Meta (es. /whatsapp-meta/send)
SENDAPP_API_ENDPOINT=/whatsapp-meta/send
# Nome del template Meta/SendApp approvato per l'invio (es. avviso_libri_prenotati)
SENDAPP_TEMPLATE_NAME=avviso_libri_prenotati
# Codice lingua del template Meta (es. it)
SENDAPP_LANGUAGE_CODE=it
# (Opzionale) Delay tra un invio e l'altro in millisecondi (default: 100)
SEND_DELAY_MS=100