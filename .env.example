# Database Configuration
POSTGRES_USER=wa-send-v2
POSTGRES_PASSWORD=wa-send-v2
POSTGRES_DB=wa-send-v2
DATABASE_URL=postgresql://wa-send-v2:wa-send-v2@db:5432/wa-send-v2?schema=public

# Security Settings
JWT_SECRET=your-super-secret-key-change-this-in-production

# SendApp API Configuration
# Token / API Key rilasciata dalla piattaforma SendApp (es. https://app.sendapp.ai o https://official.sendapp.cloud)
SENDAPP_API_TOKEN=your-sendapp-api-token-here
# (Opzionale) URL base API SendApp - Default: https://official.sendapp.cloud/api (o https://app.sendapp.ai/api)
SENDAPP_API_URL=https://official.sendapp.cloud/api
# (Opzionale) Endpoint invio template - Default: /send/template (o /whatsapp-meta/send)
SENDAPP_API_ENDPOINT=/send/template
# (Opzionale) Nome del template Meta/SendApp configurato per l'invio messaggi
SENDAPP_TEMPLATE_NAME=avviso_libri_prenotati
# (Opzionale) Codice lingua del template Meta (es. it)
SENDAPP_LANGUAGE_CODE=it

